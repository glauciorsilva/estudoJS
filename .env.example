# Copie para .env (local) e preencha com os dados do seu app web no Firebase:
# Console do Firebase → Configurações do projeto → Seus apps → App da Web → SDK config.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.
# Sem estas variáveis o app roda em "modo local" (progresso só no navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true" mostra o botão "Criar conta" no login. Deixe vazio para só o administrador criar contas.
VITE_ALLOW_SIGNUP=
